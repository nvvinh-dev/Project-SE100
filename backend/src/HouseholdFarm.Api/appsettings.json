{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "nong-nghiep-api",
    "Audience": "nong-nghiep-web",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "RefreshCookieSecure": true,
    "LockoutMaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "App": {
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "Reminders": {
    "UpcomingDays": 3
  },
  "Ai": {
    "Model": "",
    "DailyQuotaPerHousehold": 50,
    "MaxOutputTokens": 1024
  }
}
